# YourDriveAI - Email Configuration
# Copy this file to .env and fill in your SMTP credentials.
# When EMAIL_HOST is set, SMTP backend is used automatically.
# When EMAIL_HOST is empty/absent, console backend is used (prints emails to terminal).

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=YourDriveAI <noreply@yourdriveai.com>
