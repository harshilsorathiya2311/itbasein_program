import numpy as np

# Function to calculate grade
def calculate_grade(mark):
    if mark >= 90:
        return "A"
    elif mark >= 80:
        return "B"
    elif mark >= 70:
        return "C"
    elif mark >= 60:
        return "D"
    elif mark >= 50:
        return "E"
    else:
        return "F"

# Input number of students
n = int(input("Enter number of students: "))

# User-defined input
names = []
marks = []

for i in range(n):
    name = input(f"Enter name of student {i+1}: ")
    mark = int(input(f"Enter marks of {name}: "))

    names.append(name)
    marks.append(mark)

# Convert to NumPy arrays
names = np.array(names)
marks = np.array(marks)

# Display data
print("\nStudent Names:", names)
print("Student Marks:", marks)

# Average marks
average = np.mean(marks)
print("Average Marks:", average)

# Highest marks
highest_marks = np.max(marks)
print("Highest Marks:", highest_marks)

# Lowest marks
lowest_marks = np.min(marks)
print("Lowest Marks:", lowest_marks)

# Total marks
total_marks = np.sum(marks)
print("Total Marks:", total_marks)

# Median
median_marks = np.median(marks)
print("Median Marks:", median_marks)

# Pass/Fail
pass_student = np.where(marks >= 33, "Pass", "Fail")
print("Pass/Fail Status:", pass_student)

# Grades
grades = [calculate_grade(mark) for mark in marks]
print("Grades:", grades)

# Student Report
print("\n----- Student Report -----")
for name, mark, status, grade in zip(names, marks, pass_student, grades):
    print(f"{name} -> Marks: {mark}, Status: {status}, Grade: {grade}")